<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#111111">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSnap"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="SNAP &amp; CALCULATE"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="#222222"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:text="Snap job card or enter Fare &amp; Total km below." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etFare"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:hint="Fare (RM)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="10dp"
            android:background="#262626"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF" />

        <EditText
            android:id="@+id/etTotalKm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:hint="Total km"
            android:inputType="numberDecimal"
            android:paddingHorizontal="10dp"
            android:background="#262626"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF" />

        <Button
            android:id="@+id/btnManualCalc"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="CALC" />
    </LinearLayout>

</LinearLayout>
